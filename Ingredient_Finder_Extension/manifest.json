{
  "manifest_version": 3,
  "name": "Ecommupscale Ingredient Finder",
  "version": "1.6.0",
  "description": "Read ingredients and supplement facts of any Amazon product, find similar supplements anywhere on the web, or type your ingredients and find Amazon products that contain them.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ecommupscale Ingredient Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}